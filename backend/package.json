{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "start": "node dist/server.js",
    "test": "tsx --test src/test/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.19.1",
    "@timeline/core": "1.0.0",
    "fastify": "^4.28.1",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "fastify-plugin": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}